# Hermes Proxy Configuration
# This file contains sensitive credentials - DO NOT commit to git!

# Required: Bearer token for authenticating requests to the proxy
# Generate a random token: python -c "import secrets; print(secrets.token_hex(32))"
HERMES_PROXY_TOKEN=your-secret-bearer-token-here

# Optional: Hermes webhook URL (default: http://localhost:8644/webhooks/rail-proxy)
# HERMES_WEBHOOK_URL=http://localhost:8644/webhooks/rail-proxy

# Optional: Webhook secret for HMAC signature validation
# HERMES_WEBHOOK_SECRET=your-webhook-secret
